{
  "name": "debriefpro",
  "displayName": "DebriefPro",
  "publisher": "debriefpro",
  "description": "Local-first VS Code extension for planning, tracking, and debriefing software work.",
  "version": "0.1.0",
  "license": "MIT",
  "icon": "media/debriefpro-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/debriefpro"
  },
  "homepage": "https://github.com/your-org/debriefpro",
  "bugs": {
    "url": "https://github.com/your-org/debriefpro/issues"
  },
  "main": "./out/extension.js",
  "bin": {
    "debrief": "./out/cli.js"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:debriefProSidebar",
    "onCommand:debriefpro.openSidebar",
    "onCommand:debriefpro.createProject",
    "onCommand:debriefpro.createTask",
    "onCommand:debriefpro.updateTaskStatus",
    "onCommand:debriefpro.startSession",
    "onCommand:debriefpro.pauseSession",
    "onCommand:debriefpro.resumeSession",
    "onCommand:debriefpro.endSession",
    "onCommand:debriefpro.refreshGit",
    "onCommand:debriefpro.generateDebrief"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debriefPro",
          "title": "DebriefPro",
          "icon": "media/debriefpro-icon.png"
        }
      ]
    },
    "views": {
      "debriefPro": [
        {
          "id": "debriefProSidebar",
          "name": "Overview"
        }
      ]
    },
    "commands": [
      {
        "command": "debriefpro.openSidebar",
        "title": "DebriefPro: Open Sidebar"
      },
      {
        "command": "debriefpro.createProject",
        "title": "DebriefPro: Create Project"
      },
      {
        "command": "debriefpro.createTask",
        "title": "DebriefPro: Create Task"
      },
      {
        "command": "debriefpro.updateTaskStatus",
        "title": "DebriefPro: Update Task Status"
      },
      {
        "command": "debriefpro.startSession",
        "title": "DebriefPro: Start Session"
      },
      {
        "command": "debriefpro.pauseSession",
        "title": "DebriefPro: Pause Session"
      },
      {
        "command": "debriefpro.resumeSession",
        "title": "DebriefPro: Resume Session"
      },
      {
        "command": "debriefpro.endSession",
        "title": "DebriefPro: End Session"
      },
      {
        "command": "debriefpro.refreshGit",
        "title": "DebriefPro: Refresh Git Activity"
      },
      {
        "command": "debriefpro.generateDebrief",
        "title": "DebriefPro: Generate Debrief"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "debrief": "node ./out/cli.js",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "keywords": [
    "planning",
    "productivity",
    "software engineering",
    "developer workflow"
  ],
  "author": "DebriefPro",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  }
}
